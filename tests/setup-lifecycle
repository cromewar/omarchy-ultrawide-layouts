#!/usr/bin/env bash
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
helper="$here/../bin/hypr-layout-preset"
mock_bin="$here/mocks"
test_root=$(mktemp -d)
trap 'rm -rf -- "$test_root"' EXIT

pass=0
fail=0

check() {
  local name="$1" expected="$2" actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    printf '  \033[32mok\033[0m    %-38s %s\n' "$name" "$actual"
    pass=$((pass + 1))
  else
    printf '  \033[31mFAIL\033[0m  %-38s expected %s, got %s\n' "$name" "$expected" "$actual"
    fail=$((fail + 1))
  fi
}

reset_configs() {
  rm -rf -- "$test_root/config" "$test_root/state"
  mkdir -p "$test_root/config/hypr" "$test_root/state"
  printf '%s\n' \
    'dofile("/usr/share/omarchy/default/hypr/bootstrap.lua")' \
    'require("default.hypr.omarchy")' \
    'require("hypr.bindings")' \
    'require("default.hypr.toggles")' \
    >"$test_root/config/hypr/hyprland.lua"
  printf '%s\n' '-- personal bindings' >"$test_root/config/hypr/bindings.lua"
}

run_helper() {
  PATH="$mock_bin:$PATH" \
  HOME="$test_root" \
  XDG_CONFIG_HOME="$test_root/config" \
  XDG_STATE_HOME="$test_root/state" \
  MOCK_KEYBINDINGS="${MOCK_KEYBINDINGS:-SUPER + SPACE → Omarchy menu\\n}" \
  MOCK_RELOAD_MARKER="${MOCK_RELOAD_MARKER:-}" \
  MOCK_CONFIG_ERROR_FILE="${MOCK_CONFIG_ERROR_FILE:-}" \
  MOCK_LOCK_PERSIST="${MOCK_LOCK_PERSIST:-1}" \
  MOCK_EVAL_LOG="${MOCK_EVAL_LOG:-}" \
  MOCK_LAYOUT="${MOCK_LAYOUT:-master}" \
  HYPRLAND_INSTANCE_SIGNATURE="mock-session" \
    "$helper" "$@"
}

printf '\nSetup lifecycle — install, idempotency, teardown\n'
reset_configs
run_helper setup >/dev/null
hypr="$test_root/config/hypr/hyprland.lua"
binds="$test_root/config/hypr/bindings.lua"
check "provider marker installed" 1 "$(grep -c '^-- BEGIN cromewar.ultrawide-layouts lock provider$' "$hypr")"
check "provider loads before toggles" yes "$(awk '
  /lock provider/ && !provider { provider=NR }
  /require\("default.hypr.toggles"\)/ { toggles=NR }
  END { print (provider && toggles && provider < toggles) ? "yes" : "no" }
' "$hypr")"
check "default key installed" yes "$(grep -Fq 'SUPER + ALT + L' "$binds" && echo yes || echo no)"
check "hyprland backup created" yes "$([[ -r "$hypr.ultrawide-layouts.bak" ]] && echo yes || echo no)"

run_helper setup >/dev/null
check "setup is idempotent (provider)" 1 "$(grep -c '^-- BEGIN cromewar.ultrawide-layouts lock provider$' "$hypr")"
check "setup is idempotent (binding)" 1 "$(grep -c '^-- BEGIN cromewar.ultrawide-layouts lock binding$' "$binds")"

run_helper teardown >/dev/null
check "teardown removes provider" 0 "$(grep -c '^-- BEGIN cromewar.ultrawide-layouts lock provider$' "$hypr" || true)"
check "teardown removes binding" 0 "$(grep -c '^-- BEGIN cromewar.ultrawide-layouts lock binding$' "$binds" || true)"
check "teardown preserves user config" yes "$(grep -Fq 'require("hypr.bindings")' "$hypr" && echo yes || echo no)"

printf '\nLock lifecycle — capture metadata, preset switch, unsupported layout\n'
run_helper setup >/dev/null
run_helper lock >/dev/null
meta="$test_root/state/omarchy/layout-locks/1.json"
rule="$test_root/state/omarchy/workspace-layouts/1.lua"
check "lock metadata records base preset" center "$(jq -r '.baseKey' "$meta")"
check "rule activates custom provider" yes "$(grep -Fq 'lua:cromewar-ultrawide-lock' "$rule" && echo yes || echo no)"
check "rule has restart fallback" yes "$(grep -Fq 'else hl.workspace_rule' "$rule" && echo yes || echo no)"
status=$(run_helper status)
check "status reports the underlying preset" center "$(jq -r '.key' <<<"$status")"
check "status reports active lock" true "$(jq -r '.locked' <<<"$status")"
check "status reports installed provider" true "$(jq -r '.setupPresent' <<<"$status")"
run_helper set thirds >/dev/null
check "preset selection unlocks workspace" no "$([[ -e "$meta" ]] && echo yes || echo no)"
check "preset replaces lock rule" yes "$(grep -Fq 'layout = "master"' "$rule" && ! grep -Fq 'lua:cromewar' "$rule" && echo yes || echo no)"

printf '%s\n' 'hl.workspace_rule({ workspace = "1", layout = "master", layout_opts = { orientation = "center" } })' >"$rule"
before=$(sha256sum "$rule")
eval_log="$test_root/lock-failure-eval.log"
MOCK_LOCK_PERSIST=0 MOCK_EVAL_LOG="$eval_log"
if run_helper lock >/dev/null 2>&1; then capture_result=accepted; else capture_result=rolled-back; fi
unset MOCK_LOCK_PERSIST MOCK_EVAL_LOG
check "missing capture state rejects lock" rolled-back "$capture_result"
check "failed lock restores prior rule" "$before" "$(sha256sum "$rule")"
check "failed lock clears metadata" no "$([[ -e "$meta" ]] && echo yes || echo no)"
check "rollback restores center orientation" yes "$(grep -Fq 'orientation = "center"' "$eval_log" && echo yes || echo no)"
check "rollback restores exact ratio" yes "$(grep -Fq 'mfact exact 0.5' "$eval_log" && echo yes || echo no)"

MOCK_LAYOUT=scrolling
status=$(run_helper status)
check "scrolling status explains unsupported lock" false "$(jq -r '.lockSupported' <<<"$status")"
if run_helper lock >/dev/null 2>&1; then scrolling_result=accepted; else scrolling_result=rejected; fi
unset MOCK_LAYOUT
check "scrolling lock is rejected" rejected "$scrolling_result"
run_helper teardown >/dev/null

printf '\nSetup lifecycle — conflict detection\n'
reset_configs
before=$(sha256sum "$hypr" "$binds")
MOCK_KEYBINDINGS='ALT SUPER + L → Existing action\n'
if run_helper setup >/dev/null 2>&1; then conflict_result=accepted; else conflict_result=rejected; fi
unset MOCK_KEYBINDINGS
check "conflicting key is rejected" rejected "$conflict_result"
check "conflict changes no config" "$before" "$(sha256sum "$hypr" "$binds")"

printf '\nSetup lifecycle — config-error rollback\n'
reset_configs
before=$(sha256sum "$hypr" "$binds")
MOCK_RELOAD_MARKER="$test_root/reloaded"
MOCK_CONFIG_ERROR_FILE="$test_root/reloaded"
if run_helper setup >/dev/null 2>&1; then rollback_result=accepted; else rollback_result=rolled-back; fi
unset MOCK_RELOAD_MARKER MOCK_CONFIG_ERROR_FILE
rm -f "$test_root/reloaded"
check "new config error rejects setup" rolled-back "$rollback_result"
check "rollback restores both files" "$before" "$(sha256sum "$hypr" "$binds")"

printf '\n'
if ((fail == 0)); then
  printf '\033[32m%d setup checks passed\033[0m\n\n' "$pass"
else
  printf '\033[31m%d passed, %d failed\033[0m\n\n' "$pass" "$fail"
fi
exit $((fail > 0))
