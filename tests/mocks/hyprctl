#!/usr/bin/env bash
set -u

if [[ "${1:-}" == "--batch" ]]; then
  layout="${MOCK_LAYOUT:-master}"
  printf '{"id":1,"monitor":"TEST","tiledLayout":"%s","windows":3,"hasfullscreen":false}\n' "$layout"
  printf '[{"name":"TEST","width":1200,"height":800,"scale":1,"transform":0}]\n'
  printf '[{"workspace":{"id":1},"floating":false,"mapped":true,"hidden":false,"fullscreen":0,"at":[0,0],"size":[300,800]},{"workspace":{"id":1},"floating":false,"mapped":true,"hidden":false,"fullscreen":0,"at":[300,0],"size":[600,800]},{"workspace":{"id":1},"floating":false,"mapped":true,"hidden":false,"fullscreen":0,"at":[900,0],"size":[300,800]}]\n'
  printf '{"int":2}\n'
  printf '{"str":"center"}\n'
  exit 0
fi

case "${1:-}" in
  # Hyprland's Lua config has no legacy parser: both of these are hard errors
  # on 0.56, exactly as they are here.
  dispatch)
    printf "error: [string \"return hl.dispatch(%s)\"]:1: ')' expected\n" "${2:-}" >&2
    exit 1
    ;;
  keyword)
    printf "keyword can't work with non-legacy parsers. Use eval.\n" >&2
    exit 1
    ;;
  configerrors)
    if [[ -n "${MOCK_CONFIG_ERROR_FILE:-}" && -e "$MOCK_CONFIG_ERROR_FILE" ]]; then
      printf 'mock configuration error\n'
    fi
    ;;
  reload)
    if [[ -n "${MOCK_RELOAD_MARKER:-}" ]]; then
      : >"$MOCK_RELOAD_MARKER"
    fi
    exit "${MOCK_RELOAD_EXIT:-0}"
    ;;
  activeworkspace)
    printf '{"id":1}\n'
    ;;
  activewindow)
    if [[ -n "${MOCK_ACTIVEWINDOW_BEFORE:-}" ]]; then
      printf '%s\n' "$MOCK_ACTIVEWINDOW_BEFORE"
    else
      printf '%s\n' '{"address":"0x1","workspace":{"id":1},"at":[0,0],"size":[300,800]}'
    fi
    ;;
  eval)
    if [[ "$*" == *begin_capture* ]] &&
        grep -Fq 'lua:cromewar-ultrawide-lock' "$XDG_STATE_HOME/omarchy/workspace-layouts/1.lua" 2>/dev/null; then
      printf 'custom rule was published before capture\n' >&2
      exit 42
    fi
    if [[ "$*" == *begin_capture* && "${MOCK_LOCK_PERSIST:-1}" == "1" ]]; then
      mkdir -p "$XDG_STATE_HOME/omarchy/layout-locks"
      printf '%s\n' 'return { version = 1, workspace = 1, dynamic_zone = 3, column_count = 3 }' \
        >"$XDG_STATE_HOME/omarchy/layout-locks/1.lua"
    fi
    if [[ -n "${MOCK_EVAL_LOG:-}" ]]; then
      printf '%s\n' "${2:-}" >>"$MOCK_EVAL_LOG"
    fi
    if [[ -n "${MOCK_EVAL_FAIL:-}" && "$*" == *"$MOCK_EVAL_FAIL"* ]]; then
      printf 'error: mock refused this chunk\n' >&2
      exit 7
    fi
    exit 0
    ;;
  *)
    printf '[]\n'
    ;;
esac
