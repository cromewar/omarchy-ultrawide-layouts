#!/bin/bash
# hypr-layout-preset — switch the focused Hyprland workspace between layout
# presets chosen for a super-ultrawide panel.
#
# Hyprland keeps three separate knobs for this:
#   * the workspace's layout        (dwindle | master | scrolling)
#   * the master layout orientation (left | right | center | ...)
#   * mfact, the master's share of the width
# A "preset" is one fixed combination of the three. Layout and orientation are
# workspace rules, so they persist across `hyprctl reload` once written to
# Omarchy's workspace-layouts state dir. mfact is not expressible as a rule and
# has to go through the layoutmsg dispatcher, which acts on the focused
# workspace — which is why every command here operates on the focused workspace.
#
# Reading the layout back is done by measuring the tiled columns, not by
# trusting a remembered value: a manual resize, a fresh session or Omarchy's own
# SUPER + L toggle all change the layout without telling us. The one thing that
# cannot be measured is orientation — `left` at mfact 0.4 and `right` at 0.6
# produce identical column sets — so that is read back out of the rule file we
# wrote, falling back to the global option when Omarchy's toggle has overwritten
# it (that toggle writes no orientation).
set -uo pipefail

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
PRESET_DIR="$STATE_HOME/omarchy/layout-presets"
# Shared with omarchy-hyprland-workspace-layout-toggle (SUPER + L) on purpose,
# so both write the same file and neither silently loses to the other.
RULE_DIR="$STATE_HOME/omarchy/workspace-layouts"
LOCK_DIR="$STATE_HOME/omarchy/layout-locks"

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PLUGIN_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
LOCK_PROVIDER="$PLUGIN_ROOT/layouts/locked.lua"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR_CONFIG_DIR="$CONFIG_HOME/hypr"
HYPRLAND_CONFIG="$HYPR_CONFIG_DIR/hyprland.lua"
BINDINGS_CONFIG="$HYPR_CONFIG_DIR/bindings.lua"

LOCK_LAYOUT="lua:cromewar-ultrawide-lock"
LOCK_PROVIDER_BEGIN="-- BEGIN cromewar.ultrawide-layouts lock provider"
LOCK_PROVIDER_END="-- END cromewar.ultrawide-layouts lock provider"
LOCK_BINDING_BEGIN="-- BEGIN cromewar.ultrawide-layouts lock binding"
LOCK_BINDING_END="-- END cromewar.ultrawide-layouts lock binding"
DEFAULT_LOCK_KEY="SUPER + ALT + L"

# key|label|icon|layout|orientation|mfact   (cycle order)
PRESETS=(
  "center|Center master||master|center|0.5"
  "thirds|Even thirds||master|center|0.3334"
  "left|Master left||master|left|0.5"
  "right|Master right||master|right|0.5"
  "dwindle|Dwindle|󰕰|dwindle||"
  "scrolling|Scrolling|󰓡|scrolling||"
)

MFACT_MIN=0.15
MFACT_MAX=0.85

# How far the measured ratio may drift from the stored preset before the label
# follows it. Must exceed half the gap between the two centre presets (0.083).
MFACT_HYSTERESIS=0.11

# Windows in one master column share an x exactly, and neighbouring columns sit
# a full column apart, so this only has to absorb fractional-scale rounding.
COLUMN_TOLERANCE=8

# Off by default: the bar widget shows the change itself, so a toast on every
# click would be noise. The keybinding passes --notify, where there is nothing
# else to confirm the press.
NOTIFY=0

notify_error() {
  [[ "$NOTIFY" == "1" ]] || return 0
  command -v omarchy-notification-send >/dev/null || return 0
  omarchy-notification-send -g "󰚌" "Layout lock" "$*" >/dev/null 2>&1 || true
}

die()  { notify_error "$*"; printf 'hypr-layout-preset: %s\n' "$*" >&2; exit 1; }
warn() { printf 'hypr-layout-preset: %s\n' "$*" >&2; }

# Checked in main() rather than at load time, so tests can source this file for
# its pure functions on a machine with no compositor running.
require_deps() {
  command -v hyprctl >/dev/null || die "hyprctl not found"
  command -v jq >/dev/null || die "jq not found"
}

# ---------------------------------------------------------------- preset table

# Split on '|' without forking a `cut` per lookup. Empty fields are preserved.
field() {
  local -a parts
  IFS='|' read -ra parts <<<"$1"
  printf '%s\n' "${parts[$(($2 - 1))]:-}"
}

keys() { local row; for row in "${PRESETS[@]}"; do printf '%s\n' "${row%%|*}"; done; }

row_for() {
  local key="$1" row
  for row in "${PRESETS[@]}"; do
    [[ "${row%%|*}" == "$key" ]] && { printf '%s\n' "$row"; return 0; }
  done
  return 1
}

# Only ordinary workspaces get a rule file. Special workspaces have negative
# ids, and anything non-numeric would be interpolated straight into a Lua file
# that Omarchy executes on every config reload — and because
# default/hypr/require_all.lua has no pcall, one bad file there aborts the whole
# reload, not just this plugin.
valid_ws() { [[ "$1" =~ ^[1-9][0-9]*$ ]]; }

# ----------------------------------------------------------------------- probe

# Every compositor read in one IPC round-trip, so nothing can shift underneath
# us between queries and the bar does not pay for a process chain per event.
# Emits a single object; every command below consumes it.
PROBE_CORE="j/activeworkspace; j/monitors; j/clients"
PROBE_OPTS="j/getoption master:slave_count_for_center_master; j/getoption master:orientation"

probe() {
  local out
  # Fast path: everything in one batch.
  out=$(hyprctl --batch "$PROBE_CORE; $PROBE_OPTS" 2>/dev/null | probe_jq) && [[ -n "$out" ]] && {
    printf '%s\n' "$out"
    return 0
  }
  # A failed sub-command makes hyprctl print a bare error line — not JSON — and
  # still exit 0, which poisons the whole slurp and would leave the widget with
  # nothing to parse. The two getoptions are the only fragile part (an option
  # Hyprland renames one day), so drop them and fall back to their defaults
  # rather than losing the layout entirely.
  out=$(hyprctl --batch "$PROBE_CORE" 2>/dev/null | probe_jq) && [[ -n "$out" ]] && {
    printf '%s\n' "$out"
    return 0
  }
  printf '%s\n' '{"ok":false,"workspace":0,"monitor":"","width":0,"layout":"","windows":0,"hasfullscreen":false,"center_threshold":2,"global_orientation":"left","columns":[],"span":0}'
}

probe_jq() {
  # Errors here are an expected, handled outcome — probe() retries — so they are
  # not worth printing. A real failure surfaces as ok:false.
  jq -s -e --argjson tol "$COLUMN_TOLERANCE" 2>/dev/null '
    {ws: .[0], mons: .[1], clients: .[2],
     centerop: (.[3] // {}), orientop: (.[4] // {})}
    | .ws as $ws
    | (.mons[]? | select(.name == $ws.monitor)) as $m
    | ($ws.id) as $wsid
    # Logical width: what Hyprland lays windows out in. A rotated monitor
    # swaps the axes.
    | (if $m == null then 0
       elif (($m.transform // 0) % 2) == 1 then ($m.height / $m.scale)
       else ($m.width / $m.scale) end | round) as $width
    # Only windows that actually occupy a tile. A fullscreen window covers the
    # whole monitor and would otherwise read as a master at mfact 1.0.
    | ([ .clients[]?
         | select(.workspace.id == $wsid
                  and .floating == false
                  and .mapped == true
                  and (.hidden // false) == false
                  and (.fullscreen // 0) == 0)
         | {x: .at[0], w: .size[0]} ]
       | sort_by(.x)) as $win
    # Collapse stacked windows into the column they share.
    | (reduce $win[] as $c ([];
        if (length == 0) or (($c.x - .[-1].x) > $tol)
        then . + [{x: $c.x, w: $c.w}]
        else .[0:-1] + [{x: .[-1].x, w: ([.[-1].w, $c.w] | max)}]
        end)) as $cols
    | {
        ok: true,
        workspace: $wsid,
        monitor: ($ws.monitor // ""),
        width: $width,
        layout: ($ws.tiledLayout // ""),
        windows: ($ws.windows // 0),
        tiled: ($win | length),
        hasfullscreen: ($ws.hasfullscreen // false),
        center_threshold: (.centerop.int // 2),
        global_orientation: (.orientop.str // "left"),
        columns: $cols,
        span: ([$cols[].w] | add // 0)
      }'
}

# ----------------------------------------------------------------- measurement

# The master column's share of the tiled span, given the orientation.
#
# Reads probe JSON on stdin so it can be exercised against fixtures with no
# compositor attached — see tests/run.
#
# Two things matter here. The master is picked by POSITION, never by width: the
# widest window is the master only while mfact is above 0.5 (left/right) or 1/3
# (center), and below that the widest column is a slave. And the denominator is
# the column span rather than the monitor width, which cancels gaps_in/gaps_out
# instead of leaving a systematic ~1% undershoot to be papered over later.
#
# Prints nothing when the layout cannot be measured (an empty workspace, one
# window, everything fullscreen, or a centre master that has too few slaves to
# have engaged). Callers fall back to the stored value rather than a guess.
measure_mfact() {
  local orientation="$1" threshold="$2"
  jq -r --arg o "$orientation" --argjson need "$threshold" '
    .columns as $c | ($c | length) as $n | (.span // 0) as $span
    | (if (.hasfullscreen // false) then null
       # A fullscreen window covers the monitor and its column drops out of the
       # set, so the remaining columns no longer span the workspace. Filtering it
       # would yield a confident wrong ratio; refusing is the honest answer.
       elif $n == 0 or $span == 0 then null
       # The master layout puts slaves in vertical stacks, so it produces two
       # columns (left/right) or three (centre, engaged) and never more. One
       # column carries no ratio, and anything above three is not a master column
       # set at all — a vertical orientation, or a layout we do not model.
       elif $n == 1 or $n > 3 then null
       elif $o == "center" then (if $n >= ($need + 1) then (($n / 2) | floor) else null end)
       elif $o == "right"  then $n - 1
       elif $o == "left"   then 0
       else null end) as $mi
    | if $mi == null then "" else (($c[$mi].w / $span * 10000 | round) / 10000) end'
}

# Nearest preset among those sharing this orientation. left and right have one
# candidate each; centre has two (centre master and even thirds), separated by
# the measured ratio.
nearest_key() {
  local orientation="$1" mfact="$2" row
  {
    for row in "${PRESETS[@]}"; do
      [[ "$(field "$row" 4)" == "master" ]] || continue
      [[ "$(field "$row" 5)" == "$orientation" ]] || continue
      printf '%s %s\n' "$(field "$row" 1)" "$(field "$row" 6)"
    done
  } | awk -v m="$mfact" '
      BEGIN { best = ""; bd = 1e9 }
      { d = $2 - m; if (d < 0) d = -d; if (d < bd) { bd = d; best = $1 } }
      END { print best }'
}

# The preset the workspace is currently in.
#
# Identity is (layout, orientation, mfact). Layout comes from Hyprland, so a
# SUPER + L toggle or a hand-edited config is reported honestly. Orientation
# comes from the rule. mfact only has to separate centre from thirds — which is
# why losing it on a one-window workspace no longer loses your place in the
# cycle, the way the old nearest-mfact search over every preset did.
#
# Reads probe JSON on stdin. Testable without a compositor.
resolve_key() {
  local orientation="$1" threshold="$2" fallback_mfact="$3" stored="${4:-}"
  local probe layout mfact key srow snominal
  probe=$(cat)
  layout=$(jq -r '.layout // ""' <<<"$probe")

  case "$layout" in
    dwindle | scrolling)
      printf '%s\n' "$layout"
      return 0
      ;;
    master) ;;
    *)
      # An empty or third-party layout. Report it as-is rather than claiming a
      # preset we are not in.
      printf '%s\n' "$layout"
      return 0
      ;;
  esac

  mfact=$(printf '%s' "$probe" | measure_mfact "$orientation" "$threshold")
  [[ -z "$mfact" ]] && mfact="$fallback_mfact"

  key=$(nearest_key "$orientation" "$mfact")

  # Hysteresis. Centre and thirds share an orientation and differ only in ratio,
  # so a plain nearest-match flips the label the instant a drag crosses the
  # midpoint at 0.417 — which also silently moves what middle-click snaps back
  # to, and what `next` steps from. While the stored preset is still a plausible
  # reading of what is on screen, keep it.
  #
  # The two ratios are 0.167 apart, so the threshold has to exceed half of that
  # (0.083) to leave any band at all; MFACT_HYSTERESIS is set one scroll notch
  # beyond the midpoint, so a single notch past centre still reads as centre.
  if [[ -n "$stored" && "$stored" != "$key" ]] && srow=$(row_for "$stored") &&
    [[ "$(field "$srow" 4)" == "master" && "$(field "$srow" 5)" == "$orientation" ]]; then
    snominal=$(field "$srow" 6)
    awk -v a="$mfact" -v b="$snominal" -v h="$MFACT_HYSTERESIS" \
      'BEGIN{d=a-b; if(d<0)d=-d; exit !(d < h)}' && key="$stored"
  fi

  # A master layout on an orientation we have no preset for (e.g. someone set
  # master:orientation=top by hand).
  printf '%s\n' "${key:-$layout}"
}

# ------------------------------------------------------------------ orientation

# Read back out of the rule we wrote. Omarchy's own layout toggle shares this
# file and writes no orientation, so an absent key legitimately means "whatever
# the global option says" rather than a missing value.
rule_orientation() {
  local ws="$1" global="$2" live_layout="${3:-}" f="$RULE_DIR/$ws.lua" o="" l=""
  if [[ -r "$f" ]]; then
    l=$(sed -n 's/.*layout[[:space:]]*=[[:space:]]*"\([a-z]*\)".*/\1/p' "$f" | head -1)
    # Trust the orientation only while the file still describes the live layout.
    # Omarchy's own SUPER + L toggle rewrites this file with a different layout
    # and no orientation at all, and a rule can lose to another rule — either
    # way what is left behind is a stale orientation for a layout we are no
    # longer in.
    if [[ -z "$live_layout" || "$l" == "$live_layout" ]]; then
      o=$(sed -n 's/.*orientation[[:space:]]*=[[:space:]]*"\([a-z]*\)".*/\1/p' "$f" | head -1)
    fi
  fi
  printf '%s\n' "${o:-$global}"
}

# ----------------------------------------------------------------------- state

stored_key() {
  local f="$PRESET_DIR/$1.key" v=""
  [[ -r "$f" ]] && v=$(<"$f")
  [[ "$v" =~ ^[a-z]+$ ]] || v=""
  printf '%s\n' "$v"
}

stored_mfact() {
  local f="$PRESET_DIR/$1.mfact" v=""
  [[ -r "$f" ]] && v=$(<"$f")
  # Anything not a plain decimal is treated as absent: this value is fed to
  # --argjson, where a malformed one would abort the status output.
  [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || v="0.5"
  printf '%s\n' "$v"
}

write_state() {
  local ws="$1" key="$2" mfact="$3"
  valid_ws "$ws" || return 0
  mkdir -p "$PRESET_DIR" || { warn "cannot create $PRESET_DIR"; return 1; }
  [[ -n "$key" ]] && printf '%s\n' "$key" >"$PRESET_DIR/$ws.key"
  [[ -n "$mfact" ]] && printf '%s\n' "$mfact" >"$PRESET_DIR/$ws.mfact"
  return 0
}

lock_meta_path() { printf '%s/%s.json\n' "$LOCK_DIR" "$1"; }
lock_layout_path() { printf '%s/%s.lua\n' "$LOCK_DIR" "$1"; }

lock_meta_current() {
  local ws="$1" file session
  file=$(lock_meta_path "$ws")
  [[ -r "$file" ]] || return 1
  session="${HYPRLAND_INSTANCE_SIGNATURE:-}"
  [[ -n "$session" ]] || return 1
  jq -e --arg session "$session" '.version == 1 and .session == $session' "$file" >/dev/null 2>&1
}

lock_base_field() {
  local ws="$1" field_name="$2" file
  file=$(lock_meta_path "$ws")
  [[ -r "$file" ]] || return 1
  jq -r --arg field "$field_name" '.[$field] // ""' "$file"
}

lock_dynamic_zone() {
  local ws="$1" file value=""
  file=$(lock_layout_path "$ws")
  if [[ -r "$file" ]]; then
    value=$(sed -n 's/^[[:space:]]*dynamic_zone[[:space:]]*=[[:space:]]*\([0-9][0-9]*\),.*/\1/p' "$file" | head -1)
  fi
  printf '%s\n' "$value"
}

lock_column_count() {
  local ws="$1" file value=""
  file=$(lock_layout_path "$ws")
  if [[ -r "$file" ]]; then
    value=$(sed -n 's/^[[:space:]]*column_count[[:space:]]*=[[:space:]]*\([0-9][0-9]*\),.*/\1/p' "$file" | head -1)
  fi
  printf '%s\n' "$value"
}

write_lock_meta() {
  local ws="$1" key="$2" layout="$3" orientation="$4" mfact="$5" session="$6" tmp
  mkdir -p "$LOCK_DIR" || die "cannot create $LOCK_DIR"
  tmp=$(mktemp "$LOCK_DIR/.$ws.meta.XXXXXX") || die "mktemp failed in $LOCK_DIR"
  if jq -nc \
    --argjson version 1 --argjson workspace "$ws" \
    --arg session "$session" --arg key "$key" --arg layout "$layout" \
    --arg orientation "$orientation" --arg mfact "$mfact" \
    '{version:$version, workspace:$workspace, session:$session,
      baseKey:$key, baseLayout:$layout, baseOrientation:$orientation,
      baseMfact:$mfact}' >"$tmp" && mv -f "$tmp" "$(lock_meta_path "$ws")"; then
    return 0
  fi
  rm -f "$tmp"
  die "failed to write lock metadata for workspace $ws"
}

clear_lock_state() {
  local ws="$1"
  valid_ws "$ws" || return 1
  rm -f "$(lock_meta_path "$ws")" "$(lock_layout_path "$ws")" "$LOCK_DIR/$ws.lua.tmp"
}

provider_installed() {
  [[ -r "$LOCK_PROVIDER" && -r "$HYPRLAND_CONFIG" ]] || return 1
  grep -Fq -- "$LOCK_PROVIDER_BEGIN" "$HYPRLAND_CONFIG" &&
    grep -Fq -- "dofile(\"$(lua_escape "$LOCK_PROVIDER")\")" "$HYPRLAND_CONFIG"
}

# Rewritten in place via a temp file: this directory is sourced by Hyprland on
# every config reload, and a half-written file is a syntax error that takes the
# whole reload down with it. The temp name deliberately does not end in .lua, so
# require_all's `find -name '*.lua'` cannot pick it up mid-write.
write_rule_file() {
  local ws="$1" content="$2" tmp
  valid_ws "$ws" || die "refusing to write a workspace rule for '$ws'"
  mkdir -p "$RULE_DIR" || die "cannot create $RULE_DIR"
  tmp=$(mktemp "$RULE_DIR/.$ws.rule.XXXXXX") || die "mktemp failed in $RULE_DIR"
  # mktemp gives 0600; these files sit alongside Omarchy's own, which are
  # written through a plain redirect, so match the umask rather than tightening
  # only the ones this script happens to have touched.
  chmod "$(printf '%o' $((0666 & ~$(umask))))" "$tmp" 2>/dev/null
  if printf '%s\n' "$content" >"$tmp" && mv -f "$tmp" "$RULE_DIR/$ws.lua"; then
    return 0
  fi
  rm -f "$tmp"
  die "failed to write $RULE_DIR/$ws.lua"
}

# Workspaces come and go; their state files should not outlive them.
prune_state() {
  local live f base ws meta_session layout orientation
  live=$(hyprctl workspaces -j 2>/dev/null | jq -r '.[].id' | tr '\n' ' ')
  [[ -n "$live" ]] || return 0

  # A compositor restart invalidates window identities even when the numeric
  # workspace still exists. Replace its conditional lock rule with the saved
  # base rule and discard the stale geometry.
  for f in "$LOCK_DIR"/*.json; do
    [[ -r "$f" ]] || continue
    ws=$(jq -r '.workspace // 0' "$f")
    valid_ws "$ws" || continue
    meta_session=$(jq -r '.session // ""' "$f")
    if [[ "$meta_session" != "${HYPRLAND_INSTANCE_SIGNATURE:-}" || " $live " != *" $ws "* ]]; then
      layout=$(jq -r '.baseLayout // "dwindle"' "$f")
      orientation=$(jq -r '.baseOrientation // ""' "$f")
      write_rule_file "$ws" "$(build_rule_lua "$ws" "$layout" "$orientation")"
      clear_lock_state "$ws"
    fi
  done

  for f in "$PRESET_DIR"/*.key "$PRESET_DIR"/*.mfact; do
    [[ -e "$f" ]] || continue
    base=$(basename "$f"); base="${base%.*}"
    [[ " $live " == *" $base "* ]] || rm -f "$f"
  done
}

# -------------------------------------------------------------------- geometry

# Column widths a preset produces on a monitor this wide, gaps excluded.
#
# `cols` is how many tiled columns the workspace actually has. It matters
# because a centre master only engages once it has slave_count_for_center_master
# slaves; below that Hyprland lays it out as a plain split, and advertising
# three columns would be a lie.
geometry_for() {
  local key="$1" width="$2" mfact="$3" cols="${4:-0}" threshold="${5:-2}"
  local row layout orientation master side
  row=$(row_for "$key") || { printf '\n'; return; }
  layout=$(field "$row" 4)
  orientation=$(field "$row" 5)
  [[ -z "$width" || "$width" -le 0 ]] && { printf '\n'; return; }

  case "$layout" in
    master)
      master=$(awk -v w="$width" -v m="$mfact" 'BEGIN{printf "%d", w*m}')
      side=$((width - master))
      if [[ "$orientation" == "center" ]] && ((cols >= threshold + 1)); then
        side=$(awk -v w="$width" -v m="$master" 'BEGIN{printf "%d", (w-m)/2}')
        printf '%s · %s · %s\n' "$side" "$master" "$side"
      elif [[ "$orientation" == "right" ]]; then
        printf '%s · %s\n' "$side" "$master"
      else
        printf '%s · %s\n' "$master" "$side"
      fi
      ;;
    dwindle) printf 'binary split\n' ;;
    scrolling) printf 'scrolling columns\n' ;;
  esac
}

clamp_mfact() {
  awk -v v="$1" -v lo="$MFACT_MIN" -v hi="$MFACT_MAX" \
    'BEGIN{ if (v<lo) v=lo; if (v>hi) v=hi; printf "%.4f", v }'
}

# ---------------------------------------------------------------------- apply

lua_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  printf '%s\n' "$value"
}

# The rule and the ratio go out as one Lua chunk in a single `hyprctl eval`.
# Sent as two calls, the mfact layoutmsg can land while the workspace is still
# on the old layout — dwindle ignores it — and the ratio is silently lost.
# The workspace rule on its own — this is what gets persisted.
build_rule_lua() {
  local ws="$1" layout="$2" orientation="$3"
  if [[ -n "$orientation" ]]; then
    printf 'hl.workspace_rule({ workspace = "%s", layout = "%s", layout_opts = { orientation = "%s" } })' \
      "$ws" "$layout" "$orientation"
  else
    printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })' "$ws" "$layout"
  fi
}

build_locked_rule_lua() {
  local ws="$1" session="$2" base_layout="$3" base_orientation="$4" active fallback
  active=$(build_rule_lua "$ws" "$LOCK_LAYOUT" "")
  fallback=$(build_rule_lua "$ws" "$base_layout" "$base_orientation")
  printf 'if os.getenv("HYPRLAND_INSTANCE_SIGNATURE") == "%s" then %s else %s end\n' \
    "$(lua_escape "$session")" "$active" "$fallback"
}

build_begin_lock_lua() {
  local ws="$1" expected="$2" session="$3" rule
  rule=$(build_rule_lua "$ws" "$LOCK_LAYOUT" "")
  printf 'if not _G.cromewar_ultrawide_lock then error("layout lock provider is not loaded") end; if not _G.cromewar_ultrawide_lock.begin_capture(%s, %s, "%s") then error("layout capture refused") end; %s\n' \
    "$ws" "$expected" "$(lua_escape "$session")" "$rule"
}

build_cancel_lock_lua() {
  local ws="$1" layout="$2" orientation="$3" mfact="$4" tiled="${5:-0}" apply
  apply=$(build_apply_lua "$ws" "$layout" "$orientation" "$mfact" "$tiled")
  printf 'if _G.cromewar_ultrawide_lock then _G.cromewar_ultrawide_lock.cancel_capture(%s) end; %s\n' \
    "$ws" "$apply"
}

# The full chunk `set` executes: the rule, plus the ratio when there is
# something to apply it to.
#
# Pure, and split out from apply_preset precisely so tests can assert the ratio
# is actually in there. It went missing once — apply_preset took the tiled count
# as its fifth argument and set_preset passed four, so the guard below read 0
# and silently dropped the mfact from every `set`. Nothing caught it, because
# the workspace under test already happened to be at the right ratio.
build_apply_lua() {
  local ws="$1" layout="$2" orientation="$3" mfact="$4" tiled="${5:-0}" lua
  lua=$(build_rule_lua "$ws" "$layout" "$orientation")
  # On an empty workspace `layoutmsg mfact` fails with "no window", and because
  # the two share a chunk that failure would take the rule down with it — pcall
  # does not help, hyprctl still reports the error. Nothing needs resizing there
  # anyway, and the ratio lands when the preset is next applied.
  if [[ -n "$mfact" ]] && ((tiled > 0)); then
    lua="$lua; hl.dispatch(hl.dsp.layout(\"mfact exact $mfact\"))"
  fi
  printf '%s\n' "$lua"
}

apply_preset() {
  local ws="$1" layout="$2" orientation="$3" mfact="$4" tiled="${5:-0}" rule lua

  rule=$(build_rule_lua "$ws" "$layout" "$orientation")
  write_rule_file "$ws" "$rule"
  lua=$(build_apply_lua "$ws" "$layout" "$orientation" "$mfact" "$tiled")

  if hyprctl eval "$lua" >/dev/null 2>&1; then
    return 0
  fi

  warn "hyprctl eval rejected the workspace rule; falling back to hyprctl keyword"
  hyprctl keyword workspace "$ws, layout:$layout" >/dev/null 2>&1 ||
    warn "fallback 'hyprctl keyword workspace' also failed"
  if [[ -n "$mfact" ]]; then
    hyprctl dispatch layoutmsg "mfact exact $mfact" >/dev/null 2>&1 ||
      warn "could not apply mfact $mfact"
  fi
}

apply_mfact() {
  hyprctl eval "hl.dispatch(hl.dsp.layout(\"mfact exact $1\"))" >/dev/null 2>&1 ||
    warn "could not apply mfact $1"
}

# --------------------------------------------------------------- layout lock

lock_support_reason() {
  local probe="$1" key="$2" ws tiled
  ws=$(jq -r '.workspace // 0' <<<"$probe")
  tiled=$(jq -r '.tiled // 0' <<<"$probe")
  valid_ws "$ws" || { printf 'Layout lock is only available on ordinary workspaces\n'; return 1; }
  provider_installed || {
    printf 'Run %s setup to enable the Hyprland layout provider\n' "$SCRIPT_DIR/hypr-layout-preset"
    return 1
  }
  [[ "$(jq -r '.hasfullscreen // false' <<<"$probe")" == "false" ]] || {
    printf 'Exit fullscreen before locking this workspace\n'
    return 1
  }
  ((tiled >= 2)) || {
    printf 'Open at least two tiled windows before locking the layout\n'
    return 1
  }
  [[ "$key" != "scrolling" ]] || {
    printf 'The scrolling layout cannot be locked\n'
    return 1
  }
  row_for "$key" >/dev/null || {
    printf 'The current third-party layout cannot be locked\n'
    return 1
  }
  return 0
}

lock_workspace() {
  local probe="${1:-}" ws key reason layout orientation threshold mfact session tiled
  local locked_rule begin_lua previous lock_file attempt capture_ok=0 had_previous=0
  [[ -n "$probe" ]] || probe=$(probe)
  ws=$(jq -r '.workspace // 0' <<<"$probe")
  valid_ws "$ws" || die "no ordinary focused workspace (got '$ws')"
  lock_meta_current "$ws" && return 0

  key=$(current_key "$probe" "$ws")
  if ! reason=$(lock_support_reason "$probe" "$key"); then die "$reason"; fi
  layout=$(jq -r '.layout // ""' <<<"$probe")
  orientation=$(rule_orientation "$ws" "$(jq -r '.global_orientation' <<<"$probe")" "$layout")
  threshold=$(jq -r '.center_threshold // 2' <<<"$probe")
  mfact=$(printf '%s' "$probe" | measure_mfact "$orientation" "$threshold")
  [[ -n "$mfact" ]] || mfact=$(stored_mfact "$ws")
  session="${HYPRLAND_INSTANCE_SIGNATURE:-}"
  [[ -n "$session" ]] || die "HYPRLAND_INSTANCE_SIGNATURE is unavailable"
  tiled=$(jq -r '.tiled // 0' <<<"$probe")

  mkdir -p "$RULE_DIR" "$LOCK_DIR" || die "cannot create layout state directories"
  previous=$(mktemp "$RULE_DIR/.$ws.previous.XXXXXX") || die "cannot stage the previous workspace rule"
  if [[ -r "$RULE_DIR/$ws.lua" ]]; then
    cp "$RULE_DIR/$ws.lua" "$previous"
    had_previous=1
  fi

  write_lock_meta "$ws" "$key" "$layout" "$orientation" "$mfact" "$session"
  locked_rule=$(build_locked_rule_lua "$ws" "$session" "$layout" "$orientation")
  write_rule_file "$ws" "$locked_rule"
  begin_lua=$(build_begin_lock_lua "$ws" "$tiled" "$session")

  lock_file=$(lock_layout_path "$ws")
  if hyprctl eval "$begin_lua" >/dev/null 2>&1; then
    # Layout handoff is normally synchronous, but give the compositor a brief
    # chance to finish transferring targets before declaring capture failed.
    for attempt in {1..10}; do
      [[ -s "$lock_file" ]] && { capture_ok=1; break; }
      sleep 0.02
    done
  fi
  if ((capture_ok == 0)); then
    if ((had_previous)); then cp "$previous" "$RULE_DIR/$ws.lua"; else rm -f "$RULE_DIR/$ws.lua"; fi
    clear_lock_state "$ws"
    hyprctl eval "$(build_cancel_lock_lua "$ws" "$layout" "$orientation" "$mfact" "$tiled")" >/dev/null 2>&1 || true
    rm -f "$previous"
    die "Hyprland could not capture the layout lock; the previous $key layout was restored"
  fi
  rm -f "$previous"
  write_state "$ws" "$key" "$mfact"
}

unlock_workspace() {
  local probe="${1:-}" ws key layout orientation mfact tiled
  [[ -n "$probe" ]] || probe=$(probe)
  ws=$(jq -r '.workspace // 0' <<<"$probe")
  valid_ws "$ws" || die "no ordinary focused workspace (got '$ws')"
  [[ -r "$(lock_meta_path "$ws")" ]] || return 0

  key=$(lock_base_field "$ws" baseKey)
  layout=$(lock_base_field "$ws" baseLayout)
  orientation=$(lock_base_field "$ws" baseOrientation)
  mfact=$(lock_base_field "$ws" baseMfact)
  tiled=$(jq -r '.tiled // 0' <<<"$probe")
  [[ -n "$layout" ]] || die "lock metadata for workspace $ws has no base layout"

  apply_preset "$ws" "$layout" "$orientation" "$mfact" "$tiled"
  clear_lock_state "$ws"
  write_state "$ws" "$key" "$mfact"
}

lock_layout_message() {
  local message="$1" label="$2" probe ws
  probe=$(probe)
  ws=$(jq -r '.workspace // 0' <<<"$probe")
  lock_meta_current "$ws" || die "the focused workspace is not layout-locked"
  hyprctl dispatch layoutmsg "$message" >/dev/null 2>&1 || die "Hyprland could not $label"
}

notify_lock_state() {
  [[ "$NOTIFY" == "1" ]] || return 0
  command -v omarchy-notification-send >/dev/null || return 0
  local st title detail
  st=$(cmd_status)
  [[ "$st" == "{}" ]] && return 0
  if [[ "$(jq -r '.locked' <<<"$st")" == "true" ]]; then
    title="Layout locked"
    detail="$(jq -r '.label' <<<"$st") · dynamic column $(jq -r '.dynamicZone // "?"' <<<"$st")"
  else
    title="Layout unlocked"
    detail="$(jq -r '.label' <<<"$st")"
  fi
  omarchy-notification-send -g "󰌾" "$title" "$detail"
}

# -------------------------------------------------------------------- commands

set_preset() {
  local key="$1" probe="${2:-}" row ws layout orientation mfact tiled was_locked=0
  row=$(row_for "$key") || die "unknown preset: $key (try: $(keys | paste -sd' '))"
  [[ -n "$probe" ]] || probe=$(probe)
  ws=$(jq -r '.workspace' <<<"$probe")
  valid_ws "$ws" || die "no ordinary focused workspace (got '$ws')"
  # How many tiled windows there are to resize. Without this the ratio is
  # dropped from every `set`.
  tiled=$(jq -r '.tiled // 0' <<<"$probe")

  layout=$(field "$row" 4)
  orientation=$(field "$row" 5)
  mfact=$(field "$row" 6)

  lock_meta_current "$ws" && was_locked=1
  apply_preset "$ws" "$layout" "$orientation" "$mfact" "$tiled"
  ((was_locked)) && clear_lock_state "$ws"
  write_state "$ws" "$key" "$mfact"
}

nudge_mfact() {
  local delta="$1" probe ws layout orientation threshold current next
  probe=$(probe)
  ws=$(jq -r '.workspace' <<<"$probe")
  valid_ws "$ws" || return 1
  lock_meta_current "$ws" && die "unlock the workspace before resizing its master column"
  layout=$(jq -r '.layout // ""' <<<"$probe")
  [[ "$layout" == "master" ]] || return 1

  threshold=$(jq -r '.center_threshold' <<<"$probe")
  orientation=$(rule_orientation "$ws" "$(jq -r '.global_orientation' <<<"$probe")" "$layout")

  current=$(printf '%s' "$probe" | measure_mfact "$orientation" "$threshold")
  [[ -z "$current" ]] && current=$(stored_mfact "$ws")

  next=$(clamp_mfact "$(awk -v a="$current" -v d="$delta" 'BEGIN{print a+d}')")
  apply_mfact "$next"
  write_state "$ws" "" "$next"
  printf '%s\n' "$next"
}

step_preset() {
  local dir="$1" probe ws current all n i idx found=0
  probe=$(probe)
  ws=$(jq -r '.workspace' <<<"$probe")
  current=$(current_key "$probe" "$ws")

  mapfile -t all < <(keys)
  n=${#all[@]}
  for i in "${!all[@]}"; do
    [[ "${all[$i]}" == "$current" ]] && { idx=$i; found=1; break; }
  done

  if ((found)); then
    idx=$(((idx + dir + n) % n))
  else
    # Not in a known preset (an empty or third-party layout). Enter the cycle
    # at a defined end rather than silently landing on whatever is at index 0.
    ((dir > 0)) && idx=0 || idx=$((n - 1))
  fi

  set_preset "${all[$idx]}" "$probe"
  printf '%s\n' "${all[$idx]}"
}

# Convenience wrapper: resolve_key with the orientation and fallback filled in
# from the workspace's own state.
current_key() {
  local probe="$1" ws="$2" threshold orientation layout
  if lock_meta_current "$ws"; then
    lock_base_field "$ws" baseKey
    return
  fi
  threshold=$(jq -r '.center_threshold' <<<"$probe")
  layout=$(jq -r '.layout // ""' <<<"$probe")
  orientation=$(rule_orientation "$ws" "$(jq -r '.global_orientation' <<<"$probe")" "$layout")
  printf '%s' "$probe" |
    resolve_key "$orientation" "$threshold" "$(stored_mfact "$ws")" "$(stored_key "$ws")"
}

cmd_status() {
  local probe ws width cols threshold orientation layout key row mfact measured snapped nominal
  local locked=false lock_supported=false lock_reason="" dynamic_zone="" lock_columns="" setup_present=false
  probe=$(probe)
  ws=$(jq -r '.workspace' <<<"$probe")
  if [[ ! "$ws" =~ ^-?[0-9]+$ ]]; then
    echo '{}'
    return
  fi

  width=$(jq -r '.width' <<<"$probe")
  cols=$(jq -r '.columns | length' <<<"$probe")
  threshold=$(jq -r '.center_threshold' <<<"$probe")
  layout=$(jq -r '.layout // ""' <<<"$probe")
  if provider_installed; then setup_present=true; fi

  if lock_meta_current "$ws"; then
    locked=true
    lock_supported=true
    key=$(lock_base_field "$ws" baseKey)
    layout=$(lock_base_field "$ws" baseLayout)
    orientation=$(lock_base_field "$ws" baseOrientation)
    mfact=$(lock_base_field "$ws" baseMfact)
    dynamic_zone=$(lock_dynamic_zone "$ws")
    lock_columns=$(lock_column_count "$ws")
    [[ "$lock_columns" =~ ^[0-9]+$ ]] && cols="$lock_columns"
  else
    orientation=$(rule_orientation "$ws" "$(jq -r '.global_orientation' <<<"$probe")" "$layout")
    key=$(current_key "$probe" "$ws")
    if lock_reason=$(lock_support_reason "$probe" "$key"); then
      lock_supported=true
      lock_reason=""
    fi
  fi
  row=$(row_for "$key") || row="$key|$key||$key||"

  nominal=$(field "$row" 6)
  snapped=false

  if [[ "$locked" == "true" ]]; then
    [[ -n "$mfact" ]] || mfact="${nominal:-0.5}"
    snapped=true
  else
    measured=$(printf '%s' "$probe" | measure_mfact "$orientation" "$threshold")
  fi

  if [[ "$locked" != "true" && -z "$measured" ]]; then
    # Nothing measurable — an empty workspace, a lone window, everything
    # fullscreen, or a centre master below its slave threshold. Report the
    # preset's own ratio and do not claim it has been dragged off it.
    mfact="${nominal:-$(stored_mfact "$ws")}"
    [[ -n "$nominal" ]] && snapped=true
  elif [[ "$locked" != "true" ]]; then
    mfact="$measured"
    # Now that the span cancels the gaps, an untouched preset measures its
    # nominal ratio essentially exactly, so this only absorbs integer rounding
    # rather than a systematic offset.
    if [[ -n "$nominal" ]] &&
      awk -v a="$mfact" -v b="$nominal" 'BEGIN{d=a-b; if(d<0)d=-d; exit !(d < 0.005)}'; then
      mfact="$nominal"
      snapped=true
    fi
  fi

  jq -nc \
    --argjson snapped "$snapped" \
    --argjson locked "$locked" \
    --argjson lock_supported "$lock_supported" \
    --argjson setup_present "$setup_present" \
    --arg lock_reason "$lock_reason" \
    --arg dynamic_zone "$dynamic_zone" \
    --arg key "$key" \
    --arg label "$(field "$row" 2)" \
    --arg icon "$(field "$row" 3)" \
    --arg layout "$(field "$row" 4)" \
    --arg monitor "$(jq -r '.monitor' <<<"$probe")" \
    --arg orientation "$orientation" \
    --arg geometry "$(geometry_for "$key" "$width" "$mfact" "$cols" "$threshold")" \
    --argjson ws "$ws" \
    --argjson width "${width:-0}" \
    --argjson columns "$cols" \
    --argjson mfact "$mfact" \
    '{workspace:$ws, monitor:$monitor, width:$width, key:$key, label:$label,
      icon:$icon, layout:$layout, orientation:$orientation, mfact:$mfact,
      columns:$columns, geometry:$geometry, snapped:$snapped,
      locked:$locked, lockSupported:$lock_supported, lockReason:$lock_reason,
      setupPresent:$setup_present,
      dynamicZone:(if $dynamic_zone == "" then null else ($dynamic_zone | tonumber) end)}'
}

# Every preset with the geometry it would produce on the focused monitor, so a
# menu can show real numbers rather than the ratios they came from.
cmd_list() {
  local probe width cols threshold row key
  probe=$(probe)
  width=$(jq -r '.width' <<<"$probe")
  cols=$(jq -r '.columns | length' <<<"$probe")
  threshold=$(jq -r '.center_threshold' <<<"$probe")

  for row in "${PRESETS[@]}"; do
    key="${row%%|*}"
    jq -nc \
      --arg key "$key" \
      --arg label "$(field "$row" 2)" \
      --arg icon "$(field "$row" 3)" \
      --arg layout "$(field "$row" 4)" \
      --arg geometry "$(geometry_for "$key" "$width" "$(field "$row" 6)" "$cols" "$threshold")" \
      '{key:$key, label:$label, icon:$icon, layout:$layout, geometry:$geometry}'
  done | jq -sc .
}

notify_current() {
  [[ "$NOTIFY" == "1" ]] || return 0
  command -v omarchy-notification-send >/dev/null || return 0
  local st
  st=$(cmd_status)
  [[ "$st" == "{}" ]] && return 0
  omarchy-notification-send -g "$(jq -r '.icon' <<<"$st")" \
    "$(jq -r '.label' <<<"$st")" "$(jq -r '.geometry' <<<"$st")"
}

# --------------------------------------------------------------- setup/teardown

normalize_hotkey() {
  printf '%s\n' "$1" | awk '
    {
      gsub(/\+/, " ")
      for (i = 1; i <= NF; i++) {
        token = toupper($i)
        if (token == "SUPER" || token == "MOD4") super = 1
        else if (token == "CTRL" || token == "CONTROL") ctrl = 1
        else if (token == "ALT") alt = 1
        else if (token == "SHIFT") shift = 1
        else key = key token
      }
    }
    END {
      printf "%s%s%s%s%s\n", super ? "SUPER" : "", ctrl ? "CTRL" : "",
        alt ? "ALT" : "", shift ? "SHIFT" : "", key
    }
  '
}

key_conflicts() {
  local wanted line binding description listing
  wanted=$(normalize_hotkey "$1")
  command -v omarchy >/dev/null || return 2
  listing=$(omarchy menu keybindings --print 2>/dev/null) || return 2
  while IFS= read -r line; do
    [[ "$line" == *"→"* ]] || continue
    binding=${line%%→*}
    description=${line#*→}
    [[ "$description" == *"Toggle layout lock"* ]] && continue
    [[ "$(normalize_hotkey "$binding")" == "$wanted" ]] && {
      printf '%s\n' "$line"
      return 0
    }
  done <<<"$listing"
  return 1
}

strip_marked_block() {
  local input="$1" output="$2" begin="$3" end="$4"
  awk -v begin="$begin" -v end="$end" '
    $0 == begin {
      if (inside || seen_begin) exit 20
      inside = 1; seen_begin = 1; next
    }
    $0 == end {
      if (!inside || seen_end) exit 21
      inside = 0; seen_end = 1; next
    }
    !inside { print }
    END {
      if (inside || seen_begin != seen_end) exit 22
    }
  ' "$input" >"$output"
}

insert_provider_block() {
  local input="$1" output="$2" provider_line found
  provider_line="dofile(\"$(lua_escape "$LOCK_PROVIDER")\")"
  awk -v begin="$LOCK_PROVIDER_BEGIN" -v finish="$LOCK_PROVIDER_END" \
      -v provider="$provider_line" '
    $0 == "require(\"default.hypr.toggles\")" && !inserted {
      print begin
      print provider
      print finish
      print ""
      inserted = 1
    }
    { print }
    END { if (!inserted) exit 23 }
  ' "$input" >"$output"
}

append_binding_block() {
  local input="$1" output="$2" key="$3"
  cp "$input" "$output" || return 1
  {
    printf '\n%s\n' "$LOCK_BINDING_BEGIN"
    printf 'local ultrawide_layouts = "%s"\n' "$(lua_escape "$SCRIPT_DIR/hypr-layout-preset")"
    printf 'o.bind("%s", "Toggle layout lock", ultrawide_layouts .. " --notify toggle-lock")\n' \
      "$(lua_escape "$key")"
    printf '%s\n' "$LOCK_BINDING_END"
  } >>"$output"
}

cleanup_stage_dir() {
  local stage="$1"
  rm -f "$stage/hyprland.original" "$stage/bindings.original" \
    "$stage/hyprland.clean" "$stage/bindings.clean" \
    "$stage/hyprland.next" "$stage/bindings.next"
  rmdir "$stage" 2>/dev/null || true
}

rollback_configs() {
  local stage="$1" failed=0
  cp "$stage/hyprland.original" "$HYPRLAND_CONFIG" || failed=1
  cp "$stage/bindings.original" "$BINDINGS_CONFIG" || failed=1
  hyprctl reload >/dev/null 2>&1 || true
  return "$failed"
}

edit_hypr_configs() {
  local mode="$1" key="${2:-}" stage errors conflict
  [[ -r "$HYPRLAND_CONFIG" ]] || die "missing $HYPRLAND_CONFIG"
  [[ -r "$BINDINGS_CONFIG" ]] || die "missing $BINDINGS_CONFIG"

  errors=$(hyprctl configerrors 2>/dev/null || true)
  [[ -z "$errors" ]] || die "Hyprland already has config errors; fix them before $mode"

  if [[ "$mode" == "setup" ]]; then
    if conflict=$(key_conflicts "$key"); then
      die "$key is already bound: $conflict (choose another with setup --key \"...\")"
    elif [[ $? -eq 2 ]]; then
      die "cannot inspect Omarchy keybindings before setup"
    fi
  fi

  stage=$(mktemp -d "$HYPR_CONFIG_DIR/.ultrawide-layouts.XXXXXX") || die "cannot stage Hyprland config"
  cp "$HYPRLAND_CONFIG" "$stage/hyprland.original" || { cleanup_stage_dir "$stage"; die "cannot back up hyprland.lua"; }
  cp "$BINDINGS_CONFIG" "$stage/bindings.original" || { cleanup_stage_dir "$stage"; die "cannot back up bindings.lua"; }

  if ! strip_marked_block "$stage/hyprland.original" "$stage/hyprland.clean" \
      "$LOCK_PROVIDER_BEGIN" "$LOCK_PROVIDER_END" ||
    ! strip_marked_block "$stage/bindings.original" "$stage/bindings.clean" \
      "$LOCK_BINDING_BEGIN" "$LOCK_BINDING_END"; then
    cleanup_stage_dir "$stage"
    die "the plugin's config markers are incomplete or duplicated; no files were changed"
  fi

  if [[ "$mode" == "setup" ]]; then
    if ! insert_provider_block "$stage/hyprland.clean" "$stage/hyprland.next" ||
      ! append_binding_block "$stage/bindings.clean" "$stage/bindings.next" "$key"; then
      cleanup_stage_dir "$stage"
      die "could not construct the Hyprland config update"
    fi
  else
    cp "$stage/hyprland.clean" "$stage/hyprland.next"
    cp "$stage/bindings.clean" "$stage/bindings.next"
  fi

  chmod --reference="$HYPRLAND_CONFIG" "$stage/hyprland.next" 2>/dev/null || true
  chmod --reference="$BINDINGS_CONFIG" "$stage/bindings.next" 2>/dev/null || true
  if [[ ! -e "$HYPRLAND_CONFIG.ultrawide-layouts.bak" ]] &&
    ! cp "$HYPRLAND_CONFIG" "$HYPRLAND_CONFIG.ultrawide-layouts.bak"; then
    cleanup_stage_dir "$stage"
    die "cannot create the hyprland.lua backup"
  fi
  if [[ ! -e "$BINDINGS_CONFIG.ultrawide-layouts.bak" ]] &&
    ! cp "$BINDINGS_CONFIG" "$BINDINGS_CONFIG.ultrawide-layouts.bak"; then
    cleanup_stage_dir "$stage"
    die "cannot create the bindings.lua backup"
  fi

  if ! mv -f "$stage/hyprland.next" "$HYPRLAND_CONFIG" ||
    ! mv -f "$stage/bindings.next" "$BINDINGS_CONFIG" ||
    ! hyprctl reload >/dev/null 2>&1; then
    if ! rollback_configs "$stage"; then
      die "Hyprland reload failed and automatic rollback failed; originals remain in $stage"
    fi
    cleanup_stage_dir "$stage"
    die "Hyprland reload failed; the original config was restored"
  fi

  errors=$(hyprctl configerrors 2>/dev/null || true)
  if [[ -n "$errors" ]]; then
    if ! rollback_configs "$stage"; then
      die "Hyprland reported a config error and rollback failed; originals remain in $stage"
    fi
    cleanup_stage_dir "$stage"
    die "Hyprland reported a config error; the original config was restored: $errors"
  fi
  cleanup_stage_dir "$stage"
}

restore_all_locks() {
  local file ws key layout orientation mfact rule active_ws tiled=0
  active_ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 0')
  [[ -d "$LOCK_DIR" ]] || return 0
  for file in "$LOCK_DIR"/*.json; do
    [[ -r "$file" ]] || continue
    ws=$(jq -r '.workspace // 0' "$file")
    valid_ws "$ws" || continue
    key=$(jq -r '.baseKey // ""' "$file")
    layout=$(jq -r '.baseLayout // "dwindle"' "$file")
    orientation=$(jq -r '.baseOrientation // ""' "$file")
    mfact=$(jq -r '.baseMfact // ""' "$file")
    rule=$(build_rule_lua "$ws" "$layout" "$orientation")
    write_rule_file "$ws" "$rule"
    if [[ "$ws" == "$active_ws" ]]; then
      tiled=$(probe | jq -r '.tiled // 0')
      hyprctl eval "$(build_apply_lua "$ws" "$layout" "$orientation" "$mfact" "$tiled")" >/dev/null 2>&1 || true
    else
      hyprctl eval "$rule" >/dev/null 2>&1 || true
    fi
    clear_lock_state "$ws"
    write_state "$ws" "$key" "$mfact"
  done
}

cmd_setup() {
  local key="$DEFAULT_LOCK_KEY"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --key)
        [[ $# -ge 2 && -n "$2" ]] || die "setup --key needs a key chord"
        key="$2"
        shift 2
        ;;
      *) die "unknown setup option: $1" ;;
    esac
  done
  [[ -r "$LOCK_PROVIDER" ]] || die "missing layout provider: $LOCK_PROVIDER"
  edit_hypr_configs setup "$key"
  printf 'Layout lock enabled on %s.\n' "$key"
}

cmd_teardown() {
  restore_all_locks
  edit_hypr_configs teardown
  printf 'Layout lock disabled; saved workspace layouts were restored.\n'
}

usage() {
  cat <<USAGE
hypr-layout-preset — ultrawide layout presets for the focused workspace

  list            every preset as JSON, with the widths it gives on this monitor
  status          the focused workspace's current preset as JSON
  get             the current preset key
  set <key>       apply a preset
  next | prev     step through the presets in order
  snap            re-apply the current preset (undo a manual resize)
  wider [step]    grow the master   (default step 0.025)
  narrower [step] shrink the master
  lock            capture and hold the current tiled window slots
  unlock          return the workspace to its underlying preset
  toggle-lock     lock or unlock the focused workspace
  recapture-lock  replace the saved slots with the current arrangement
  dynamic-focused make the focused window's column the dynamic column
  setup [--key "SUPER + ALT + L"]
                  install the provider and lock keybinding transactionally
  teardown        unlock all workspaces and remove the installed config blocks
  prune           drop state for workspaces that no longer exist

Presets: $(keys | paste -sd' ')

Pass --notify before a subcommand to raise a desktop notification.
The setup command uses it for the layout-lock keybinding.
USAGE
}

main() {
  require_deps
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --notify) NOTIFY=1; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  local probe ws
  case "${1:-status}" in
    list) cmd_list ;;
    status) cmd_status ;;
    get)
      probe=$(probe)
      current_key "$probe" "$(jq -r '.workspace' <<<"$probe")"
      ;;
    set)
      [[ $# -ge 2 ]] || die "set needs a preset key"
      set_preset "$2"
      notify_current
      ;;
    next) step_preset 1 >/dev/null; notify_current ;;
    prev) step_preset -1 >/dev/null; notify_current ;;
    snap)
      probe=$(probe)
      ws=$(jq -r '.workspace' <<<"$probe")
      lock_meta_current "$ws" && die "unlock the workspace before snapping its preset ratio"
      set_preset "$(current_key "$probe" "$ws")" "$probe"
      notify_current
      ;;
    wider) nudge_mfact "${2:-0.025}" ;;
    narrower) nudge_mfact "-${2:-0.025}" ;;
    lock) lock_workspace; notify_lock_state ;;
    unlock) unlock_workspace; notify_lock_state ;;
    toggle-lock)
      probe=$(probe)
      ws=$(jq -r '.workspace // 0' <<<"$probe")
      if lock_meta_current "$ws"; then unlock_workspace "$probe"; else lock_workspace "$probe"; fi
      notify_lock_state
      ;;
    recapture-lock) lock_layout_message recapture "recapture the layout lock"; notify_lock_state ;;
    dynamic-focused) lock_layout_message dynamic-focused "change the dynamic column"; notify_lock_state ;;
    setup) cmd_setup "$@" ;;
    teardown) cmd_teardown ;;
    prune) prune_state ;;
    -h | --help | help) usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

# Sourcing the script exposes the pure functions (measure_mfact, resolve_key,
# nearest_key, geometry_for) without running a command — that is how tests/run
# exercises them against fixtures with no compositor attached.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
